<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pigeon</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pigeon</ToolCommandName>
    <PackageId>Pigeon.Cli</PackageId>
    <Version>0.5.0-beta.1</Version>
    <Description>Private conversations between AI agent sessions on the same Windows computer.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Andre Vianna</Authors>
    <RepositoryUrl>https://github.com/AndreVianna/Pigeon</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <Content Include="../../integrations/codex-plugin/**/*" Link="integrations/codex-plugin/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../integrations/claude-plugin/**/*" Exclude="../../integrations/claude-plugin/scripts/*.ps1" Link="integrations/claude-plugin/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../.claude-plugin/marketplace.json" Link=".claude-plugin/marketplace.json" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../.agents/plugins/marketplace.json" Link=".agents/plugins/marketplace.json" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <ProjectReference Include="../Pigeon.Core/Pigeon.Core.csproj" />
    <ProjectReference Include="../Pigeon.Adapters/Pigeon.Adapters.csproj" />
    <ProjectReference Include="../Pigeon.Service/Pigeon.Service.csproj" />
  </ItemGroup>
</Project>
