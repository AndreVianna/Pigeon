{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume",
      "hooks": [
        { "type": "command", "command": "pigeon hook session-start codex", "timeout": 5 },
        { "type": "mcp_tool", "server": "pigeon", "tool": "pigeon_session_restore", "input": { "tool": "codex", "sessionId": "${session_id}" }, "timeout": 5 }
      ]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "mcp_tool",
        "server": "pigeon",
        "tool": "pigeon_session_restore",
        "input": { "tool": "codex", "sessionId": "${session_id}" },
        "timeout": 5
      }]
    }]
  }
}
