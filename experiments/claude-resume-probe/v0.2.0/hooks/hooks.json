{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume",
      "hooks": [
        {
          "type": "command",
          "command": "python \"${CLAUDE_PLUGIN_ROOT}/probe_a.py\" A1",
          "asyncRewake": true,
          "timeout": 30
        },
        {
          "type": "command",
          "command": "python \"${CLAUDE_PLUGIN_ROOT}/probe_a.py\" A2",
          "async": true,
          "asyncRewake": true,
          "timeout": 30
        }
      ]
    }]
  }
}
