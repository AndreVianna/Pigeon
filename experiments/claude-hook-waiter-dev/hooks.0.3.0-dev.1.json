{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume",
      "hooks": [{
        "type": "command",
        "command": "PIGEON_PORT=49473 \"C:/Projects/Pigeon/src/Pigeon.Cli/bin/Debug/net11.0/pigeon.exe\" hook wait claude-code",
        "async": true,
        "asyncRewake": true,
        "timeout": 600
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "PIGEON_PORT=49473 \"C:/Projects/Pigeon/src/Pigeon.Cli/bin/Debug/net11.0/pigeon.exe\" hook wait claude-code",
        "async": true,
        "asyncRewake": true,
        "timeout": 600
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "mcp_tool",
        "server": "plugin:pigeon-dev:pigeon",
        "tool": "pigeon_session_restore",
        "input": { "tool": "claude-code", "sessionId": "${session_id}" },
        "timeout": 5
      }]
    }]
  }
}
