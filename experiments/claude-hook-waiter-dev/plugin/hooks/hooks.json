{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "PIGEON_PORT=49473 PIGEON_EXE=\"C:/Projects/Pigeon/artifacts/host-test/bin/pigeon.exe\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-wait.sh\" --timeout 180 --renew",
            "async": true,
            "asyncRewake": true,
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PIGEON_PORT=49473 PIGEON_EXE=\"C:/Projects/Pigeon/artifacts/host-test/bin/pigeon.exe\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-wait.sh\" --timeout 180 --renew",
            "async": true,
            "asyncRewake": true,
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:pigeon-dev:pigeon",
            "tool": "pigeon_session_restore",
            "input": {
              "tool": "claude-code",
              "sessionId": "${session_id}"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
