<!-- Pigeon for Windows: a per-user install, no administrator rights. It puts pigeon.exe in
     %LOCALAPPDATA%\Programs\Pigeon and adds that folder to the user's PATH. It registers no
     service: `pigeon start` runs the background service on demand, as before. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Pigeon" Manufacturer="Andre Vianna" Version="$(var.ProductVersion)"
           UpgradeCode="54617578-aab4-471a-8f5e-787b3bce1948" Scope="perUser" Compressed="yes">
    <SummaryInformation Description="Private conversations between AI agent sessions" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Pigeon is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Pigeon" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Main" Directory="INSTALLFOLDER">
      <Component Id="PigeonExe" Guid="1b251bb3-c86c-4ae6-87e1-9b0e63ad906f">
        <File Id="PigeonExeFile" Source="$(var.PublishDir)\pigeon.exe" />
        <!-- A per-user component needs a key path under HKCU. -->
        <RegistryValue Root="HKCU" Key="Software\Pigeon" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- A running service holds pigeon.exe open, so an upgrade or removal stops it first; an agent
         app's Pigeon MCP server holds it too, which is why the guide says to close those apps. -->
    <CustomAction Id="StopPigeonService" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]pigeon.exe&quot; stop" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopPigeonService" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentGroupRef Id="Main" />
    </Feature>
  </Package>
</Wix>
